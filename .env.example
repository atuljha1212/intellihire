# ---------- Database: MySQL via SQLAlchemy (uncomment after `docker compose up -d mysql`).
# Left commented, IntelliHire uses a local SQLite file (data/intellihire.db) so it runs with zero setup.
# DATABASE_URL=mysql+pymysql://intellihire:intellihire@localhost:3306/intellihire

# ---------- Bootstrap admin (created on first start; change the password in Admin > Users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- LLM for grounded summaries and the agent (pick one; leave both empty for offline mode)
# Anthropic Claude
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# OpenAI or any OpenAI-compatible server (Groq, Together, Ollama: OPENAI_BASE_URL=http://localhost:11434/v1)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# ---------- Speech-to-text: "local" (openai-whisper on CPU) or "api" (OpenAI Whisper API, needs OPENAI_API_KEY)
WHISPER_MODE=local
WHISPER_MODEL=base

# ---------- NLP / vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
VECTOR_BACKEND=faiss

# ---------- Ingestion limits
MAX_RESUME_MB=5
MAX_VIDEO_MB=200
MAX_VIDEO_SECONDS=300
MAX_BATCH_FILES=100

# ---------- Login throttle
# Number of reverse proxies in front of the app (nginx, Traefik, a load balancer). When > 0 the
# client IP is read from X-Forwarded-For, that many entries from the right; 0 ignores the header
# (set it only when every request really passes through those proxies, or clients can spoof it).
TRUSTED_PROXY_HOPS=0
# Failed sign-ins within LOGIN_WINDOW_MINUTES: per username+IP, and per IP across all usernames
# (0 disables the per-IP cap, e.g. behind a NAT where every user shares one address).
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15

# Fall back to lightweight components if a model cannot load (set false in production)
ALLOW_FALLBACKS=true
